# Copy to .env for local `netlify dev`
# In Netlify Dashboard → Site settings → Environment variables (for production)

# Required — random 32+ char secret for signing sessions
KERNEL_JWT_SECRET=change-me-to-a-long-random-string

# Admin panel password (admin dashboard at /admin/)
KERNEL_ADMIN_PASSWORD=your-strong-admin-password

# Your Netlify site URL (no trailing slash)
KERNEL_SITE_URL=https://your-site.netlify.app

# Loader localhost callback (keep default unless you changed loader port)
KERNEL_LOADER_CALLBACK=http://127.0.0.1:42891/callback

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Discord OAuth ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- GitHub OAuth ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- AuthlyX (optional — license keys validated via AuthlyX API) ---
AUTHLYX_OWNER_ID=
AUTHLYX_APP_NAME=
AUTHLYX_VERSION=1.0
AUTHLYX_SECRET=

# --- Supabase (optional — persistent user + key database) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
